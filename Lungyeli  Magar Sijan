import random
import os

print("Welcome to professor assistant version 1.0.")

# Ask for Professor name
professor_name = input("Please Enter Your Name: ")
print(f"Hello Professor {professor_name}, I am here to help you create exams from a question bank.")

def load_question_bank(path):
    """Reads question bank into a list of (question, answer) pairs."""
    if not os.path.exists(path):
        return None

    with open(path, "r", encoding="utf-8") as file:
        lines = [line.strip() for line in file.readlines()]

    # Pair every question with the next line as answer
    question_pairs = []
    for i in range(0, len(lines), 2):
        if i + 1 < len(lines):
            question_pairs.append((lines[i], lines[i+1]))

    return question_pairs

while True:
    choice = input("Do you want me to help you create an exam (Yes to proceed | No to quit the program)? ")

    if choice.lower() == "no":
        print(f"Thank you professor {professor_name}. Have a good day!")
        break

    # Ask for question bank path
    path = input("Please Enter the Path to the Question Bank: ")

    question_pairs = load_question_bank(path)

    if question_pairs is None:
        print("The file path you entered is invalid. Please try again.")
        continue

    print("Yes, indeed the path you provided includes questions and answers.")

    # Number of questions to include
    try:
        num_questions = int(input("How many question-answer pairs do you want to include in your exam? "))
    except ValueError:
        print("Invalid number. Please enter a valid integer.")
        continue

    if num_questions > len(question_pairs):
        print("The question bank does not contain that many questions!")
        continue

    # Where to save exam
    output_file = input("Where do you want to save your exam? ")

    # Select random Q–A pairs
    selected = random.sample(question_pairs, num_questions)

    # Write exam file
    with open(output_file, "w", encoding="utf-8") as file:
        for q, a in selected:
            file.write("Q: " + q + "\n")
            file.write("A: " + a + "\n\n")

    print(f"Congratulations Professor {professor_name}. Your exam is created and saved in {output_file}.")
